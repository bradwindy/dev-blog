# npm 12 defaults allow-remote to "none", which wrongly blocks some registry
# packages with bundled dependencies (@tailwindcss/oxide-wasm32-wasi) and makes
# Renovate's lockfile updates fail with EALLOWREMOTE. "all" is npm 11's default.
# See https://github.com/npm/cli/issues/9548. Remove once npm fixes it.
allow-remote=all
