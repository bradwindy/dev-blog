{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Pacific/Auckland",
  "schedule": [
    "before 9am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Automerge minor and patch updates through a PR once the Check workflow passes and the release is 7 days old. Check runs lint, typecheck and the static export build.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "0.x updates can break on any bump, so they stay manual.",
      "matchCurrentVersion": "/^v?[~^]?0\\./",
      "automerge": false
    },
    {
      "groupName": "React",
      "matchPackageNames": [
        "/^react/",
        "/^@types/react/"
      ]
    },
    {
      "groupName": "Next.js",
      "matchPackageNames": [
        "/^next/",
        "/^@next//",
        "/^eslint-config-next/"
      ]
    },
    {
      "groupName": "Tailwind CSS",
      "matchPackageNames": [
        "/^tailwindcss/",
        "/^@tailwindcss//"
      ]
    }
  ],
  "platformAutomerge": false,
  "ignoreTests": false,
  "automergeType": "pr"
}
